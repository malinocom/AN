{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amir-nazi-chat-api",
  "main": "workers/chat-api/src/index.ts",
  "compatibility_date": "2026-09-01",

  "observability": {
    "enabled": false
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amir-nazi-db",
      "database_id": "7ad2bcb4-2d0f-4363-b007-b8c9c93b841f",
      "migrations_dir": "workers/chat-api/migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],

  "vars": {
    "ALLOWED_ORIGIN": "https://an-web-xi.vercel.app",
    "COOKIE_SAME_SITE": "None"
  }
}