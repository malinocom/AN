# ---------------- Vercel / Next.js ----------------
# Browser REST traffic should use the Next.js BFF to keep the session token HttpOnly.
NEXT_PUBLIC_CHAT_API_URL=/api
# Example: wss://chat-api.example.com/ws/chat
NEXT_PUBLIC_CHAT_WS_URL=wss://YOUR_WORKER_DOMAIN/ws/chat
NEXT_PUBLIC_APP_NAME=Amir & Nazi

# Server-only Vercel variables. Never prefix these with NEXT_PUBLIC_.
CHAT_WORKER_URL=https://YOUR_WORKER_DOMAIN
CHAT_WORKER_INTERNAL_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=an_session

# ---------------- Cloudflare Worker ----------------
# Non-secret vars are configured in wrangler.jsonc.
ALLOWED_ORIGIN=https://YOUR_VERCEL_OR_CUSTOM_DOMAIN
# Optional: same-site direct Worker cookies. BFF mode does not depend on them.
COOKIE_SAME_SITE=None

# Set these with `wrangler secret put`, not in a file committed to Git:
# SESSION_SECRET=<64+ random bytes/base64>
# INTERNAL_API_SECRET=<same value as Vercel CHAT_WORKER_INTERNAL_SECRET>
